<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 单页嵌入：index.html 作为 EmbeddedResource，GET / 直接读流返回（零静态文件根配置） -->
  <ItemGroup>
    <EmbeddedResource Include="DashboardPages\index.html" LogicalName="Agent.Dashboard.Pages.index.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Infrastructure\Agent.Infrastructure.csproj" />
  </ItemGroup>
</Project>
